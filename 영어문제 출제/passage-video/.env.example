# 이 파일을 복사해서 .env 로 이름을 바꾸고 키를 채우세요.
#   cp .env.example .env
#
# Google Cloud Text-to-Speech API 키
#   1. https://console.cloud.google.com 에서 프로젝트 선택
#   2. 'Cloud Text-to-Speech API' 사용 설정
#   3. API 및 서비스 > 사용자 인증 정보 > + 사용자 인증 정보 만들기 > API 키
#   4. 키 제한 > API 제한사항 > Cloud Text-to-Speech API 만 체크
#
# .env 는 .gitignore 에 들어 있어 커밋되지 않습니다. 절대 이 파일(.env.example)에 실제 키를 적지 마세요.

GOOGLE_TTS_API_KEY=
