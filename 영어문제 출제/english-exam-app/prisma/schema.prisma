generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Question {
  id           String   @id @default(cuid())
  examType     String   // "suneung" | "naesin" | "toeic" | "toefl" | "custom"
  questionType String   // "18_purpose" | "29_grammar" 등
  number       Int?     // 문항 번호
  points       Int      @default(2)

  passage     String   // 지문 (영어)
  question    String   // 발문
  choices     String   // JSON: [{label:"①", text:"...", isCorrect:false}, ...]
  answer      String   // 정답
  explanation String?  // 해설

  difficulty  String   @default("medium") // "easy" | "medium" | "hard"
  tags        String?  // JSON: ["빈칸추론", "인과관계"]
  source      String?  // 출처
  aiGenerated Boolean  @default(false)

  passageId   String?  // 원본 지문(Passage) 연결 — 지문 기반 출제일 때
  passageRef  Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examItems   ExamItem[]

  @@index([passageId])
}

model Exam {
  id           String   @id @default(cuid())
  title        String   // "2학기 중간고사 영어"
  examType     String   // "suneung" | "naesin" 등
  description  String?
  totalPoints  Int      @default(100)
  timeLimit    Int?     // 분 단위

  headerInfo   String?  // JSON: {school, grade, date, teacher}
  instructions String?  // 시험 안내문

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        ExamItem[]
}

model ExamItem {
  id           String   @id @default(cuid())
  examId       String
  questionId   String
  orderNum     Int
  customPoints Int?

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, orderNum])
}

model Passage {
  id          String   @id @default(cuid())
  textbook    String   // 교과서명: "능률 영어I", "YBM 영어II" 등
  grade       String   // 학년: "고1", "고2", "고3"
  lesson      String   // 과/단원: "Lesson 3", "Unit 5"
  title       String?  // 지문 제목 (선택)
  content     String   // 지문 본문 (영어)
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
}

model Template {
  id        String   @id @default(cuid())
  name      String   // "수능 영어 모의고사"
  examType  String
  structure String   // JSON: [{questionType:"18_purpose", count:1, points:2}, ...]
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("teacher") // "admin" | "teacher"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 관리자가 등록하는 AI 출제 지시문 (system prompt 보강)
// scope: "global" | "examType" | "questionType"
//   - global: 모든 출제에 적용
//   - examType: scopeKey 가 "suneung" / "naesin" 등
//   - questionType: scopeKey 가 "naesin_vocab" 등 문제 코드
model PromptDirective {
  id          String   @id @default(cuid())
  title       String
  body        String
  scope       String
  scopeKey    String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, scopeKey, enabled])
}

// ─── 교재 (Textbook) ───
model Textbook {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  description    String?

  coverTemplate  String   @default("classic")  // "classic" | "block" | "badge"
  pageTemplate   String   @default("default")  // 내지 템플릿 키
  themeColor     String   @default("#4FC3F7")
  brandText      String   @default("T&BEDU")
  logoText       String   @default("T")

  settings       String?  // JSON: 세부 커스터마이징 (폰트, 여백, 헤더 문구 등)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chapters       Chapter[]
}

model Chapter {
  id          String   @id @default(cuid())
  textbookId  String
  orderNum    Int
  title       String

  textbook    Textbook       @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  pages       TextbookPage[]

  @@index([textbookId])
}

model TextbookPage {
  id          String   @id @default(cuid())
  chapterId   String
  orderNum    Int
  title       String?

  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocks      Block[]

  @@index([chapterId])
}

model Block {
  id          String   @id @default(cuid())
  pageId      String
  orderNum    Int
  type        String   // "TEXT" | "HEADING" | "IMAGE" | "TABLE" | "QUESTION"
  data        String   // JSON payload (타입별 스키마 상이)

  page        TextbookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}
