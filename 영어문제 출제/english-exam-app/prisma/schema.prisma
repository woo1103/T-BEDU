generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Question {
  id           String   @id @default(cuid())
  examType     String   // "suneung" | "naesin" | "toeic" | "toefl" | "custom"
  questionType String   // "18_purpose" | "29_grammar" 등
  number       Int?     // 문항 번호
  points       Int      @default(2)

  passage     String   // 지문 (영어)
  question    String   // 발문
  choices     String   // JSON: [{label:"①", text:"...", isCorrect:false}, ...]
  answer      String   // 정답
  explanation String?  // 해설

  difficulty  String   @default("medium") // "easy" | "medium" | "hard"
  tags        String?  // JSON: ["빈칸추론", "인과관계"]
  source      String?  // 출처
  aiGenerated Boolean  @default(false)

  passageId   String?  // 원본 지문(Passage) 연결 — 지문 기반 출제일 때
  passageRef  Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examItems   ExamItem[]
  questionTags QuestionTag[]

  @@index([passageId])
}

model Exam {
  id           String   @id @default(cuid())
  title        String   // "2학기 중간고사 영어"
  examType     String   // "suneung" | "naesin" 등
  description  String?
  totalPoints  Int      @default(100)
  timeLimit    Int?     // 분 단위

  headerInfo   String?  // JSON: {school, grade, date, teacher}
  instructions String?  // 시험 안내문

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        ExamItem[]
  assessments  Assessment[]
}

model ExamItem {
  id           String   @id @default(cuid())
  examId       String
  questionId   String
  orderNum     Int
  customPoints Int?

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, orderNum])
}

model Passage {
  id          String   @id @default(cuid())
  textbook    String   // 교과서명: "능률 영어I", "YBM 영어II" 등
  grade       String   // 학년: "고1", "고2", "고3"
  lesson      String   // 과/단원: "Lesson 3", "Unit 5"
  title       String?  // 지문 제목 (선택)
  content     String   // 지문 본문 (영어)
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
}

model Template {
  id        String   @id @default(cuid())
  name      String   // "수능 영어 모의고사"
  examType  String
  structure String   // JSON: [{questionType:"18_purpose", count:1, points:2}, ...]
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("teacher") // "admin" | "teacher" | "student"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  taughtClasses  Class[]         @relation("ClassTeacher")
}

// 관리자가 등록하는 AI 출제 지시문 (system prompt 보강)
// scope: "global" | "examType" | "questionType"
//   - global: 모든 출제에 적용
//   - examType: scopeKey 가 "suneung" / "naesin" 등
//   - questionType: scopeKey 가 "naesin_vocab" 등 문제 코드
model PromptDirective {
  id          String   @id @default(cuid())
  title       String
  body        String
  scope       String
  scopeKey    String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope, scopeKey, enabled])
}

// ─── 교재 (Textbook) ───
model Textbook {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  description    String?

  coverTemplate  String   @default("classic")  // "classic" | "block" | "badge"
  pageTemplate   String   @default("default")  // 내지 템플릿 키
  themeColor     String   @default("#4FC3F7")
  brandText      String   @default("T&BEDU")
  logoText       String   @default("T")

  settings       String?  // JSON: 세부 커스터마이징 (폰트, 여백, 헤더 문구 등)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  chapters       Chapter[]
}

model Chapter {
  id          String   @id @default(cuid())
  textbookId  String
  orderNum    Int
  title       String

  textbook    Textbook       @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  pages       TextbookPage[]

  @@index([textbookId])
}

model TextbookPage {
  id          String   @id @default(cuid())
  chapterId   String
  orderNum    Int
  title       String?

  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocks      Block[]

  @@index([chapterId])
}

model Block {
  id          String   @id @default(cuid())
  pageId      String
  orderNum    Int
  type        String   // "TEXT" | "HEADING" | "IMAGE" | "TABLE" | "QUESTION"
  data        String   // JSON payload (타입별 스키마 상이)

  page        TextbookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

// ─── 학생 학습 플랫폼: 계정·조직 (P1) ───

model Center {
  id        String   @id @default(cuid())
  name      String   @unique // "청명" | "서천"
  createdAt DateTime @default(now())

  students  StudentProfile[]
  classes   Class[]
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  grade       String   // "고1" | "고2" | "고3" 등
  status      String   @default("guest") // "enrolled"(재원생) | "guest"(비재원생)
  phone       String?
  parentPhone String?
  centerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  center          Center?               @relation(fields: [centerId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  submissions     Submission[]
  achievements    AchievementSnapshot[]
  teacherComments TeacherComment[]
  wrongNotes      WrongNote[]

  @@index([centerId])
  @@index([status])
}

model Class {
  id        String   @id @default(cuid())
  centerId  String
  name      String   // "고2 심화 A"
  grade     String
  subject   String   @default("both") // "english" | "math" | "both"
  code      String   @unique // 반 코드 (재원생 등록용)
  teacherId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center      Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher     User?        @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  assignments Assignment[]

  @@index([centerId])
  @@index([code])
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String   // StudentProfile.id
  classId   String
  status    String   @default("active") // "active" | "left"
  joinedAt  DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
}

// ─── 문항 태그 (P2): 능력영역/단원/개념 → 취약점 분석 근거 ───

model Tag {
  id        String   @id @default(cuid())
  subject   String   // "english" | "math"
  kind      String   @default("영역") // "영역" | "단원" | "개념"
  name      String
  parentId  String?  // 계층(대분류>소분류) 대비
  createdAt DateTime @default(now())

  parent           Tag?               @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Tag[]              @relation("TagHierarchy")
  questionTags     QuestionTag[]
  worksheetItemTags WorksheetItemTag[]

  @@unique([subject, kind, name])
  @@index([subject])
}

model QuestionTag {
  questionId String
  tagId      String

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

// ─── 배정·제출·채점 (P3) ───

// 영어(Exam) / 수학(Worksheet, P5)을 공통으로 배정·채점하기 위한 추상화
model Assessment {
  id          String   @id @default(cuid())
  subject     String   // "english" | "math"
  type        String   // "exam" | "worksheet"
  title       String
  examId      String?
  worksheetId String?  // P5(수학)에서 사용
  createdAt   DateTime @default(now())

  exam        Exam?      @relation(fields: [examId], references: [id], onDelete: SetNull)
  worksheet   Worksheet? @relation(fields: [worksheetId], references: [id], onDelete: SetNull)
  assignments Assignment[]

  @@index([examId])
  @@index([worksheetId])
}

// 반에 문제지를 배정 (마감 포함)
model Assignment {
  id           String    @id @default(cuid())
  classId      String
  assessmentId String
  title        String
  assignedAt   DateTime  @default(now())
  dueAt        DateTime?
  active       Boolean   @default(true)

  class        Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  submissions  Submission[]

  @@index([classId])
  @@index([assessmentId])
}

// 학생의 1회 응시(제출)
model Submission {
  id           String    @id @default(cuid())
  studentId    String    // StudentProfile.id
  assignmentId String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  status       String    @default("in_progress") // in_progress | submitted | graded
  score        Int       @default(0)
  totalPoints  Int       @default(0)
  correctCount Int       @default(0)
  itemCount    Int       @default(0)

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@index([studentId])
  @@index([assignmentId])
}

// ─── 수학 외부 문제지 (P5) ───

// 업로드한 문제지(이미지/PDF) + 정답키. 문제 본문은 파일로 보고, 학생은 답만 마킹.
model Worksheet {
  id        String   @id @default(cuid())
  subject   String   @default("math")
  title     String
  source    String?  // 출처
  grade     String?
  fileUrl   String?  // 문제지 이미지/PDF URL
  itemCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       WorksheetItem[]
  assessments Assessment[]
}

model WorksheetItem {
  id           String @id @default(cuid())
  worksheetId  String
  number       Int    // 문항 번호
  answer       String // 정답키 (예: "③" 또는 "42")
  points       Int    @default(1)
  choicesCount Int?   // 객관식이면 선지 수(예: 5=①~⑤), 주관식이면 null

  worksheet    Worksheet          @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  itemTags     WorksheetItemTag[]

  @@index([worksheetId])
}

model WorksheetItemTag {
  itemId String
  tagId  String

  item   WorksheetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}

// 문항별 학생 답 + 정오
model Answer {
  id           String   @id @default(cuid())
  submissionId String
  refType      String   // "question" | "worksheet_item"
  refId        String   // Question.id 또는 WorksheetItem.id
  selected     String   // 학생이 고른 값 (①~⑤ 라벨 또는 텍스트)
  isCorrect    Boolean  @default(false)
  points       Int      @default(0)

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  wrongNote    WrongNote?

  @@index([submissionId])
}

// 성취도 스냅샷 (제출 채점 시 저장 → 성적 추이/성능)
model AchievementSnapshot {
  id           String   @id @default(cuid())
  studentId    String
  submissionId String?
  subject      String   @default("english")
  overallRate  Int      @default(0) // 0~100
  byArea       String   // JSON: [{name, rate, correct, total}]
  createdAt    DateTime @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// 오답노트 (오답 채점 시 자동 생성, 학생이 메모/완료 표시)
model WrongNote {
  id        String   @id @default(cuid())
  studentId String
  answerId  String   @unique
  note      String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answer    Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// 교사가 학생의 취약점 분석에 다는 코멘트 (수정 가능)
model TeacherComment {
  id           String   @id @default(cuid())
  teacherId    String   // User.id
  studentId    String   // StudentProfile.id
  scope        String   @default("overall") // "overall" | "area" | "submission"
  tagId        String?  // scope=area 일 때 능력영역 태그
  submissionId String?  // scope=submission 일 때
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}
